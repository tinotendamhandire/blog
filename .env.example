# used by docker-compose.yml. Copy to .env on the box and fill in real
# values — generate each with `openssl rand -hex 32`. Keep them different
# from each other: a leaked admin secret shouldn't also be a file-host
# write secret.
UPLOAD_SECRET=
ADMIN_SECRET=

# fine-grained GitHub PAT, scoped to ONLY this repo, "Contents: Read and
# write" permission — nothing else. Powers admin's Publish button (commit
# + push). See admin/README.md for how to create one.
GITHUB_TOKEN=

# the box user that owns this checkout — run `id -u` / `id -g` there to
# confirm (1000 is the common default for the first non-root user, but
# don't assume). admin runs as this user instead of the image's default
# root, so what Publish writes into .git/ and src/content/notes/ stays
# owned by whoever the deploy runner runs as too — otherwise the next
# `git pull` fails with "insufficient permission ... .git/objects".
ADMIN_UID=1000
ADMIN_GID=1000
