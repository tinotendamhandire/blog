# used by docker-compose.yml. Copy to .env on the box and fill in real
# values — generate each with `openssl rand -hex 32`. Keep them different
# from each other: a leaked admin secret shouldn't also be a file-host
# write secret.
UPLOAD_SECRET=
ADMIN_SECRET=

# fine-grained GitHub PAT, scoped to ONLY this repo, "Contents: Read and
# write" permission — nothing else. Powers admin's Publish button (commit
# + push). See admin/README.md for how to create one.
GITHUB_TOKEN=
