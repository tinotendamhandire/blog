ADMIN_SECRET=change-me
PORT=3100

# whole-repo checkout, not just the content dir — needed so the Publish
# button (git add/commit/push) has .git to work with. Point CONTENT_DIR
# at src/content/notes inside that same checkout.
REPO_DIR=/path/to/your/blog-checkout
CONTENT_DIR=/path/to/your/blog-checkout/src/content/notes

# fine-grained GitHub PAT, scoped to ONLY this repo, "Contents: Read and
# write" permission — see README.md for how to create one. Required for
# the Publish button; Save works fine without it.
GITHUB_TOKEN=

# optional — identity attached to commits the Publish button makes
GIT_AUTHOR_NAME=blog-admin
GIT_AUTHOR_EMAIL=admin@blog.tinotenda.xyz

# optional — lets the admin UI's upload panel proxy to file-host so only
# ADMIN_SECRET ever touches the browser
FILE_HOST_URL=http://file-host:3000
FILE_HOST_UPLOAD_SECRET=change-me-too
