---
// In-browser audio/video playback for uploaded files inside posts, e.g.:
//   <Media src="https://blog.tinotenda.xyz/files/abc123" kind="video" />
// Renders a custom player rather than native <video controls>/<audio
// controls> — browsers won't let CSS meaningfully restyle native media
// chrome (Firefox especially), and it never matched the site regardless
// of theme.
import MediaPlayer from './MediaPlayer.svelte';

interface Props {
  src: string;
  kind: 'video' | 'audio';
  caption?: string;
}

const { src, kind, caption } = Astro.props;
---

<figure class="post-media-figure">
  <MediaPlayer client:load {src} {kind} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .post-media-figure {
    margin: 1.5em 0;
  }
  figcaption {
    margin-top: 0.4em;
    font-size: 0.85em;
    color: var(--muted-foreground);
  }
</style>
