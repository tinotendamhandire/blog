---
// The one deliberate exception to "nothing here is discoverable" — but
// split by kind rather than one mixed feed. Still unlinked from anywhere
// on the site and still noindex/robots-disallowed like every other page;
// "public" means browsable once you have the URL, not search-findable.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Music — blog.tinotenda.xyz">
  <main class="music-hub">
    <h1>Music</h1>
    <div class="music-links">
      <a href="/music/sheet/">Sheet Music</a>
      <a href="/music/demos/">Demos</a>
    </div>
  </main>
</Layout>

<style>
  .music-hub {
    max-width: 30rem;
    margin: 0 auto;
    padding: 4rem 1.25rem;
    text-align: center;
  }
  h1 {
    font-size: 1.6rem;
    margin: 0 0 2rem;
  }
  .music-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .music-links a {
    display: block;
    padding: 1em;
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--foreground);
    font-weight: 700;
  }
  .music-links a:hover {
    border-color: var(--primary);
    color: var(--link);
  }
</style>
