---
import Layout from '../../layouts/Layout.astro';
import MusicList from '../../components/MusicList.astro';
---

<Layout title="Demos — blog.tinotenda.xyz">
  <main class="music-page">
    <h1>Demos</h1>
    <p class="intro">Rough recordings, works in progress.</p>
    <MusicList tag="demo" emptyLabel="Nothing tagged demo yet." />
  </main>
</Layout>

<style>
  .music-page {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
  }
  h1 {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
    text-align: center;
  }
  .intro {
    color: var(--muted-foreground);
    text-align: center;
    margin: 0 auto 2rem;
  }
</style>
